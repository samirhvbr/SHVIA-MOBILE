<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mesclado pelo Tauri no Info.plist do projeto iOS gerado (gen/apple).
     Sem estas chaves o iOS mata o app ao pedir mic/câmera (ditado e anexo
     por foto do ShvIA web) e a review da Apple rejeita o binário. -->
<plist version="1.0">
  <dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>O microfone é usado para ditar mensagens por voz no chat.</string>
    <key>NSCameraUsageDescription</key>
    <string>A câmera é usada para tirar fotos e anexá-las ao chat.</string>
    <!-- Face ID: sem esta chave o iOS mata o app na 1ª chamada ao Face ID (o
         gate de bloqueio local do M3). Touch ID não exige texto próprio. -->
    <key>NSFaceIDUsageDescription</key>
    <string>O Face ID desbloqueia o ShvIA localmente, sem digitar a senha a cada acesso.</string>
    <!-- Conformidade de exportação: o app só usa HTTPS/TLS padrão do sistema
         (tráfego pro ia.blue3.com.br), que é criptografia isenta. Declarar aqui
         evita a pergunta manual a CADA upload no TestFlight/App Store Connect. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
  </dict>
</plist>
